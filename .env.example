# Copy to a file OUTSIDE the repo, or export these in your shell. Never commit real values.
# The OAuth server refuses to start without an issuer (ValidateOnStart).
OAuthServer__PublicBaseUrl=http://localhost:5170
OAuthServer__Issuer=http://localhost:5170

# Entra app registration used for the on-behalf-of exchange.
OneDrive__OboTenantId=00000000-0000-0000-0000-000000000000
OneDrive__OboClientId=00000000-0000-0000-0000-000000000000
OneDrive__OboClientSecret=

# M1/M2 only: paste a Graph token from https://developer.microsoft.com/graph/graph-explorer
# to exercise the tools before any OAuth exists. Ignored once Auth:EnableOAuth is true.
Dev__GraphAccessToken=



# The client secret does NOT belong in this file. This one is committed on purpose so the
# template is shared, which is exactly how secrets escape. Supply it at the prompt from
# scripts/run-local-oauth.ps1, or keep it in a copy of this file saved outside the repository.
